<Window x:Class="ObavezeWPF.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ObavezeWPF"
        mc:Ignorable="d"
        Title="UsersWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Users" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <DataGrid Name="userstabela" Grid.Row="1" FontSize="30" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Width="*" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Email" Width="*" Binding="{Binding Email}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button Name="dugmeAdd" Width="200" Margin="10" Content="Add" FontSize="30" Click="dugmeAdd_Click"/>
            <Button Name="dugmeEdit" Width="200" Margin="10" Content="Edit" FontSize="30" Click="dugmeEdit_Click"/>
            <Button Name="dugmeDelete" Width="200" Margin="10" Content="Delete" FontSize="30" Click="dugmeDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>
