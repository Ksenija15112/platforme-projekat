<Window x:Class="ObavezeWPF.AddEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ObavezeWPF"
        mc:Ignorable="d"
        Title="AddEditUserWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Width="300" HorizontalAlignment="Left" Text="Name:" FontSize="40" VerticalAlignment="Center"/>
        <TextBox Name="unosIme" Width="400" HorizontalAlignment="Right" Text="{Binding Name}"/>
        <TextBlock Grid.Row="1" Width="300" HorizontalAlignment="Left" Text="Email:" FontSize="40" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Name="unosEmail" Width="400" HorizontalAlignment="Right" Text="{Binding Email}"/>
        <TextBlock Grid.Row="2" Width="300" HorizontalAlignment="Left" Text="Password:" FontSize="40" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="2" Name="unosPassword" Width="400" HorizontalAlignment="Right" />
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Name="dugmeSave" Grid.Row="3" Width="300" Content="Save" FontSize="30" Click="dugmeSave_Click" Margin="0,0,20,0" />
            <Button Name="dugmeZaSliku" Grid.Row="3" Width="300" Content="Choose Image" FontSize="30" Click="dugmeZaSliku_Click"/>
            <Image Name="slikaKorisnika" Width="150" Height="100"/>
        </StackPanel>
    </Grid>
</Window>
