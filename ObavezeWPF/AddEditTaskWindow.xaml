<Window x:Class="ObavezeWPF.AddEditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ObavezeWPF"
        xmlns:utils="clr-namespace:ObavezeWPF.UIUtils"
        mc:Ignorable="d"
        Title="AddEditTask" Height="550" Width="420">
    <Window.Resources>
        <ControlTemplate x:Key="ErrorControl">
            <DockPanel>
                <AdornedElementPlaceholder />
                <TextBlock Foreground="Red" FontSize="20" >!</TextBlock>
            </DockPanel>
        </ControlTemplate>

        <Style x:Key="DatePickerWithError" TargetType="{x:Type DatePicker}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!--prvi-->
            <RowDefinition Height="30"/>
            <!--drugi-->
            <RowDefinition Height="Auto"/>
            <!--treci-->
            <RowDefinition Height="Auto"/>
            <!--cetvrti-->
            <RowDefinition Height="Auto"/>
            <!--peti-->
            <RowDefinition Height="Auto"/>
            <!--sesti-->
            <RowDefinition Height="Auto"/>
            <!--sedmi-->
            <RowDefinition Height="Auto"/>
            <!--osmi-->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!--deveti-->
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <!--deseti-->
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Label Content="Id:"
            Grid.Row="1"
            Grid.Column="1"/>

        <TextBox
            Name="IdTB"
            Text="{Binding Path=Id}"
            IsReadOnly="True"
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            Width="200"
            Height="30"/>

        <Label Content="Title:"
            Grid.Row="2"
            Grid.Column="1"/>

        <TextBox
            Name="TitleTB"
            Text="{Binding Path=Title}"
            Grid.Row="2"
            Grid.Column="2"
            Margin="5"
            Width="200"
            Height="30"/>

        <Label Content="Description:"
            Grid.Row="3"
            Grid.Column="1"/>
        <!--
        <PasswordBox 
            Name="DescriptionTB"
            Password="{Binding Path=Description}"
            Grid.Row="3"
            Grid.Column="2"
            Height="75"
            Margin="5"
            />
        -->
        
        <TextBox
            Name="DescriptionTB"
            Text="{Binding Path=Description}"
            Grid.Row="3"
            Grid.Column="2"
            Height="30"
            Margin="5"
            Width="200"/>
        
        
        
        

       

        <Label Content="Due Date:"
            Grid.Row="5"
            Grid.Column="1"/>

        <DatePicker 
            Name="DueDateDP"
            SelectedDate="{Binding Path=DueDateTime}"
            Validation.ErrorTemplate="{StaticResource ErrorControl}"
            Style="{StaticResource DatePickerWithError}"
            Grid.Row="5"
            Grid.Column="2"
            Margin="5">
            
        </DatePicker>

        <Label Content="Category:"
            Grid.Row="8"
            Grid.Column="1"/>
        
        <ComboBox 
            Name="CategoryCB"
            SelectedItem="{Binding Path=Category}"
            DisplayMemberPath="Name"
            Grid.Row="8"
            Grid.Column="2"
            Margin="5"/>

        <Label Content="State:"
            Grid.Row="9"
            Grid.Column="1"/>
        <ComboBox 
            Name="StateCB"
            DisplayMemberPath="Name"
            SelectedItem="{Binding Path=State}"
            Grid.Row="9"
            Grid.Column="2"
            Margin="5"/>
        <Label Grid.Row="6" Grid.Column="1" Content="Start Date:"/>
        <DatePicker Grid.Row="6" Grid.Column="2" Name="pocetniDatum"   SelectedDate="{Binding StartDate}" Margin="5" />
        <Label Grid.Row="7" Grid.Column="1" Content="Story Points"/>
        <TextBox Name="unosStoryPoints" Grid.Row="7" Grid.Column="2" Width="70" Height="30" Margin="5" HorizontalAlignment="Left" Text="{Binding StoryPoints}"/>
        <Label Grid.Row="10" Grid.Column="1" Content="Label:"/>
        <ComboBox Name="LabelCB" Grid.Row="10" Grid.Column="2" Margin="5" DisplayMemberPath="Name" SelectedItem="{Binding Label}"  />
        <Label Grid.Row="11" Grid.Column="1" Content="User:"/>
        <ComboBox Name="UserCB" Grid.Row="11" Grid.Column="2" Margin="5" DisplayMemberPath="Name" SelectedItem="{Binding User}"/>
        <StackPanel 
            Grid.Row="12"
            Grid.Column="2"
            Orientation="Horizontal"
           
            HorizontalAlignment="Right"
            Margin="5,15,5,5"
            >
            <Button 
                Name="SaveBtn"
                Content="Save"
                Height="25"
                Width="75"
                  Click="SaveBtn_Click"/>
            <Button 
                Name="CancelBtn"
                Content="Cancel"
                Height="25"
                Width="75" 
                Margin="0,0,5,0"
                Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
