<Window x:Class="ObavezeWPF.AddEditCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ObavezeWPF"
        mc:Ignorable="d"
        Title="AddEditCategoriesWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left"  Text="Name:" FontSize="40" VerticalAlignment="Center"/>
        <TextBox Name="unesiIme" HorizontalAlignment="Right" Width="400" Height="130" VerticalAlignment="Center" Text="{Binding Name}"/>
        <CheckBox Grid.Row="1" Content="Is Active" FontSize="40" IsChecked="{Binding IsActive}">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </CheckBox.LayoutTransform>
        </CheckBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="200" Content="Save" FontSize="30" Margin="10" Click="Button_Click"/>
            <Button Width="200" Content="Cancel" FontSize="30" Margin="10" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
