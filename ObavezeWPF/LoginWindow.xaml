<Window x:Class="ObavezeWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ObavezeWPF"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Email:" FontSize="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox Name="unosEmail" Grid.Row="0" Width="400" HorizontalAlignment="Right" />
        <TextBlock Grid.Row="1" Text="Password:" FontSize="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <PasswordBox Name="unosPassword" Grid.Row="1" Width="400" HorizontalAlignment="Right"/>
        <Button Name="dugmeLogin" Grid.Row="2" Width="300" Content="Login" FontSize="30" Click="dugmeLogin_Click"/>
    </Grid>
</Window>
